# HairVision Backend Configuration

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hairvision?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://hairvision_user:your_password@your_cluster.mongodb.net/hairvision

# JWT Secret for User Authentication
JWT_SECRET=hairvision_secret_jwt_key_2026_super_secure

# Optional: Real AI Vision Model API Key (Google Gemini 1.5/2.0)
# If omitted, HairVision automatically runs in demo mode with intelligent heuristic analysis
GEMINI_API_KEY=
